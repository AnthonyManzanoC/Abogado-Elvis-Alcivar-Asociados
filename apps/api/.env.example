NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# CA pública incluida para verificar TLS con Supabase. No añadir sslmode a la URL.
DATABASE_CA_CERT=certs/supabase-root-2021.crt
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters-or-a-32-byte-base64-key
ADMIN_SEED_EMAIL=admin@alcivarlegal.local
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
UPLOADS_DIR=uploads
PUBLIC_API_URL=http://localhost:4000
